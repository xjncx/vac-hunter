HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/oauth/callback
# HeadHunter requires a real contact email; example.com addresses are rejected.
HH_USER_AGENT=JobSearcher/0.1 (replace-with-your-real-email)
HH_SEND_ENABLED=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATABASE=data/jobsearcher.db
PUBLIC_URL=http://localhost:8000
ADMIN_USER=admin
# Set this before exposing the app to the internet.
ADMIN_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
